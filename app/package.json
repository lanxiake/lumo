{
  "name": "@lumo/app",
  "version": "1.0.0",
  "private": true,
  "description": "Lumo — 儿童 AI 虚拟人学习伙伴 App（React Native + nodejs-mobile，端上直连自配 OpenAI/Anthropic）",
  "scripts": {
    "sync:assets": "node scripts/sync-live2d-assets.mjs",
    "setup:sherpa": "node scripts/setup-sherpa.mjs",
    "dev:run": "node scripts/dev-run.mjs",
    "dev:assets": "node scripts/dev-run.mjs --assets-only",
    "dev:logs": "node scripts/dev-run.mjs --logs",
    "emulator:dev": "node scripts/emulator-dev.mjs",
    "emulator:dev:no-build": "node scripts/emulator-dev.mjs --no-build",
    "emulator:dev:logs": "node scripts/emulator-dev.mjs --logs",
    "preandroid": "node scripts/sync-live2d-assets.mjs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest"
