# testing
/coverage

# dev-run.mjs 调试截图产物
/dev-shot*.png
/kids-*.png

# Live2D WebView 资源（由 scripts/sync-live2d-assets.mjs 从 windows resources + pnpm store 同步，
# 单一数据源，不重复入库）
/android/app/src/main/assets/live2d/

# node-runtime 宿主 bundle（由 scripts/build-node.mjs esbuild 生成，单一数据源=node-runtime 源码，
# 不入库；package.json 手写需保留）
/nodejs-assets/nodejs-project/main.js
/nodejs-assets/nodejs-project/main.js.map

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

