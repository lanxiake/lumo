{
  "name": "@lumo/core",
  "version": "0.1.0",
  "description": "Lumo core: virtual-human/pet logic (state machine, event mapping, expression/motion policy, lip sync, model config). Pure TS, no react/rn/electron/pixi/DOM deps.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite --config preview/vite.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
